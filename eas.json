{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "prebuildCommand": "prebuild --no-install",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "prebuildCommand": "prebuild --no-install",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "TGP_ANDROID_HEALTH_CONNECT": "0",
        "EXPO_PUBLIC_USE_MOCK_COMMAND_CENTER": "false",
        "EXPO_PUBLIC_NOTIFICATIONS_MOCK": "false",
        "EXPO_PUBLIC_FF_IOS_HIDE_NON_P2P_PURCHASES": "true",
        "EXPO_PUBLIC_FF_DELIVERABLES": "true"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "prebuildCommand": "prebuild --no-install",
      "env": {
        "TGP_ANDROID_HEALTH_CONNECT": "0",
        "EXPO_PUBLIC_USE_MOCK_COMMAND_CENTER": "false",
        "EXPO_PUBLIC_NOTIFICATIONS_MOCK": "false",
        "EXPO_PUBLIC_FF_IOS_HIDE_NON_P2P_PURCHASES": "true",
        "EXPO_PUBLIC_FF_CLIENT_CALENDAR": "true",
        "EXPO_PUBLIC_FF_MWB_PROGRAMS": "true",
        "EXPO_PUBLIC_FF_MWB_AUTOSAVE": "true",
        "EXPO_PUBLIC_FF_ROMAN_CHAT": "true",
        "EXPO_PUBLIC_FF_COMMUNITY_TAB": "true",
        "EXPO_PUBLIC_FF_COMMUNITY_HALL": "true",
        "EXPO_PUBLIC_FF_COMMUNITY_COHORTS": "true",
        "EXPO_PUBLIC_FF_DELIVERABLES": "true"
      }
    },
    "clinic": {
      "extends": "production",
      "channel": "clinic",
      "environment": "production",
      "env": {
        "TGP_ANDROID_HEALTH_CONNECT": "1",
        "EXPO_PUBLIC_USE_MOCK_COMMAND_CENTER": "false",
        "EXPO_PUBLIC_NOTIFICATIONS_MOCK": "false",
        "EXPO_PUBLIC_FF_CLIENT_TUTORIAL": "true",
        "EXPO_PUBLIC_FF_DELIVERABLES": "true",
        "EXPO_PUBLIC_FF_COMMUNITY_TAB": "true",
        "EXPO_PUBLIC_FF_COMMUNITY_HALL": "true",
        "EXPO_PUBLIC_FF_COMMUNITY_COHORTS": "true",
        "EXPO_PUBLIC_FF_COACH_BRIEF": "true",
        "EXPO_PUBLIC_FF_CLIENT_CALENDAR": "true",
        "EXPO_PUBLIC_FF_MWB_PROGRAMS": "true",
        "EXPO_PUBLIC_FF_MWB_AUTOSAVE": "true",
        "EXPO_PUBLIC_FF_CONSULTATION_ONBOARDING": "true",
        "EXPO_PUBLIC_FF_COMMUNITY_DM": "false",
        "EXPO_PUBLIC_FF_ROMAN_CHAT": "true",
        "EXPO_PUBLIC_FF_IOS_US_CREDIT_PACK_LINK": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6765847915"
      }
    },
    "clinic": {
      "extends": "production"
    }
  }
}
